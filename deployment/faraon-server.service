; systemd unit for the Faraón dedicated server (model A: one long-running
; process hosting all rooms). Install to /etc/systemd/system/, then:
;   sudo systemctl daemon-reload && sudo systemctl enable --now faraon-server
[Unit]
Description=Faraon dedicated game server (WebSocket, port 9000 loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faraon
WorkingDirectory=/opt/faraon
ExecStart=/opt/faraon/faraon_server.x86_64 --headless -- --server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
